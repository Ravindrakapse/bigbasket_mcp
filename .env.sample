# Run the browser without a visible window (recommended: true)
HEADLESS=true
# Serve over SSE/HTTP on port 8000 instead of stdio
SERVE_HTTPS=
# Override delivery coordinates (otherwise detected from IP)
BB_LATITUDE=
BB_LONGITUDE=
# Entry context: bbnow/10 = 10-minute delivery, bb-b2c/100 = standard slotted delivery
BB_ENTRY_CONTEXT=bbnow
BB_ENTRY_CONTEXT_ID=10
